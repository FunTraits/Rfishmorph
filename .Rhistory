operator         = "AT",
xlsx_flush_every = 10,
mode             = "new"
)
summary(cmp)
cmp$ratios[which(cmp$ratios$OGp.lm < 0.005 & cmp$ratios$OGp.pub > 0),]$Genus.species
cmp$ratios[which(cmp$ratios$RMl.lm > 0 & cmp$ratios$RMl.pub == 0),]$Genus.species
lm_df  <- as.data.frame(read_excel(xlsx, sheet = "Global_Landmark",
guess_max = 1048576))
lm_df = lm_df[!(apply(lm_df[,-c(1:6)],1,function(x){length(x[is.na(x)])})==46),]
fish_lm <- fishmorph_landmarks(lm_df) # rapport : quels spécimens sont incohérents
fish_lm <- as_intrait_landmarks(correct_landmark_order(fish_lm))
lm_geom <- Rfishmorph::standardize_geometry(fish_lm, orient = T,
rescale = T, dorsal_up = T)   # 2. orient + scale-bar
lm_geom <- Rfishmorph::correct_geometry_conventions(lm_geom)
fish_lm  <- Rfishmorph::impute_landmarks(as_intrait_landmarks(lm_geom),method = c("missforest_phylo"))            # 3. fill missing landmarks
fish_lm <- Rfishmorph::correct_zero_ratio_landmarks(fish_lm, reference = pub_seg,
id_col = "Genus.species",
ratios = c("OGp", "PFv"))
cmp <- Rfishmorph::compare_segments_landmarks(fish_lm, pub_seg, id_col = "Genus.species",
space = TRUE, group_col = "Order",
na_action = "missforest_phylo")
plot_segment_landmark_agreement(cmp, type = "scatter")
cmp
summary(cmp)
cmp$ratios[which(cmp$ratios$PFs.lm > 0 & cmp$ratios$PFs.pub == 0),]$Genus.species
cmp$space_shift[which(cmp$space_shift$distance > 5),]
