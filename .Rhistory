lm_geom <- standardize_geometry(lm_t)   # 2. orient + scale-bar
lm_imp  <- impute_landmarks(lm_geom,method = "missforest_phylo")            # 3. fill missing landmarks
lm_corr <- correct_geometry(lm_imp)
