?project_fishmorph
ops <- load_t26_saudrune("operators",operator = "Operator_3", species = TRUE)
## metadata table -> species carried into segments/ratios (see script 02)
sp_meta <- unique(ops[c("specimen", "code", "species", "id_status")])
lm  <- read_landmarks_csv(ops, metadata = sp_meta)
par(mfrow=c(1,2))
plot_fishmorph_shapes(lm,individuals=lm$metadata$specimen, align = TRUE)
lm_geom <- standardize_geometry(lm)   # 2. orient + scale-bar
lm_imp  <- impute_landmarks(lm_geom,method = "missforest_phylo")            # 3. fill missing landmarks
lm <- correct_geometry(lm_imp)
segmts = fishmorph_segments(lm, scale_cm = 1,na_action = "missforest_phylo")
ratios     <- fishmorph_ratios(segmts, MBl = segmts$Bl,MBw = T,na_action = "missforest_phylo")
ratio_cols <- c("BEl", "VEp", "REs", "OGp", "RMl", "BLs", "PFv", "PFs", "CPt","MBl")
proj <- project_fishmorph(specimens = ratios, reference = "FishMORPH/fishmorph_data.csv",
traits = ratio_cols)
plot(proj,arrows = T)
plot(proj,arrows = T)
plotly_fishmorph(proj)
